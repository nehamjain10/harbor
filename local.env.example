# Deployment settings for Harbor. Copy to local.env (git ignores it) and fill in; run.sh
# and scripts/preview.sh read it. Only WORKBENCH_OWNER and WORKBENCH_HOST are required.

# The Tailscale login allowed in, and the host name the site is served at.
WORKBENCH_OWNER=you@example.com
WORKBENCH_HOST=harbor.example.com

# The model gateway (an Anthropic-compatible endpoint) for non-Claude models, and the
# API key sent to it (default: the placeholder "harbor", for a gateway that accepts any).
#WORKBENCH_GATEWAY=http://127.0.0.1:3425
#WORKBENCH_GATEWAY_KEY=harbor

# The gateway's Claude relay (Claude routes through the gateway's own accounts): the
# path on the gateway that answers 200 while the relay is up, and the file holding the
# key the relay expects. Without the status path Claude models use this machine's own
# Claude Code login. WORKBENCH_CLAUDE_RELAY=0 turns the relay off.
#WORKBENCH_RELAY_STATUS_PATH=/relay-status
#WORKBENCH_RELAY_KEY_FILE=/home/you/.config/gateway/relay.key

# The gateway's usage dashboard, linked from the sidebar (no link when unset).
#WORKBENCH_DASHBOARD_URL=https://gateway.example.com/usage

# The folder a new chat starts in (absolute, or relative to the home folder; the home
# folder when unset or missing).
#WORKBENCH_DEFAULT_PROJECT=projects/main

# Remote clusters sessions can run on, as JSON [{"id", "label", "host"}] (host is an ssh
# destination; "local" with host null is this machine): inline, or in a file.
#WORKBENCH_CLUSTERS=[{"id":"local","label":"Here","host":null},{"id":"alpha","label":"Alpha","host":"alpha-login"}]
#WORKBENCH_CLUSTERS_FILE=/home/you/.config/harbor/clusters.json

# Changes to the model catalog (other gateway routes, more models, descriptions): a JSON
# file, described at the top of server/catalog.mjs.
#WORKBENCH_CATALOG_FILE=/home/you/.config/harbor/catalog.json

# scripts/preview.sh: the preview site and the live site it talks to.
#PREVIEW_ORIGIN=https://harbor.example.com:8446
#LIVE_ORIGIN=https://harbor.example.com
#PREVIEW_DIR=/home/you/.local/share/harbor-preview
#PREVIEW_LOG=/home/you/.local/share/harbor-preview/preview.log
#LIVE_DIR=/home/you/.local/share/claude-workbench
