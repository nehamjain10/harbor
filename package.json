{
  "name": "harbor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/e2e.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "dompurify": "^3.4.16",
    "express": "^5.1.0",
    "highlight.js": "^11.12.0",
    "marked": "^15.0.12",
    "preact": "^10.29.8",
    "lucide-preact": "^1.52.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.63.0"
  }
}
